# Deploy local (docker-compose.local.yml)
SA_PASSWORD=TroqueEstaSenha@2026
JWT_SECRET=troque-por-um-segredo-aleatorio

# Rodar a API local com dotnet run (fora do docker) exige a chave JWT:
# a variável Auth__Secret (mapeada para a config "Auth:Secret") é obrigatória.
# PowerShell (antes de dotnet run):
#   $env:Auth__Secret = "um-segredo-aleatorio-forte"
#   dotnet run --project src/PortalFinanceiro.API

# Deploy em producao Oracle Cloud (docker-compose.yml)
POSTGRES_USER=portal
POSTGRES_PASSWORD=TroqueEstaSenhaDeProducao@2026
POSTGRES_DB=portal_financeiro

# Sincronizar o banco local (SQL Server) com o Neon — sincronizar-banco.ps1
# Copie este arquivo para .env e preencha com os dados reais. O .env é ignorado
# pelo git porque contém senha; o arquivo sincronizar-banco-config.json foi
# descontinuado justamente por guardar a senha em texto puro.
# Uso: .\sincronizar-banco.ps1 [-DryRun] [-SkipNeondb] [-SkipBravo]
#
# Origem: SQL Server local
SQLSERVER_SERVER=(localdb)\mssqllocaldb
SQLSERVER_DATABASE=PortalFinanceiro

# Neon - neondb (o script aplica somente DDL/estrutura)
NEON_HOST=ep-xxxxxx-pooler.us-east-2.aws.neon.tech
NEON_PORT=5432
NEON_DB=neondb
NEON_USER=neondb_owner
NEON_PASSWORD=troque-por-a-senha-real

# Neon - neondb_bravo (o script aplica DDL e DML/dados; recria o banco)
BRAVO_HOST=ep-xxxxxx-pooler.us-east-2.aws.neon.tech
BRAVO_PORT=5432
BRAVO_DB=neondb_bravo
BRAVO_USER=neondb_owner
BRAVO_PASSWORD=troque-por-a-senha-real

# Ferramentas e pasta temporária do script
PSQL_PATH=psql
SYNC_TEMPDIR=C:\Users\SeuUsuario\AppData\Local\Temp\opencode\sincronizar-banco